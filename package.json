{
  "name": "skincarevault-serverside",
  "version": "1.0.0",
  "description": "Skincare Vault API — Express, TypeScript, MongoDB",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "ecommerce",
    "express",
    "mongodb"
  ],
  "license": "UNLICENSED",
  "_moduleAliases": {
    "@": "src"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.3.4",
    "mongoose": "^8.9.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sanitize-html": "^2.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/sanitize-html": "^2.13.0",
    "pino-pretty": "^13.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true
  }
}
