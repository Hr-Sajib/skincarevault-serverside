# ---- runtime -------------------------------------------------------------
NODE_ENV=development
PORT=5050

# ---- database ------------------------------------------------------------
# Atlas, or the local replica set started by docker-compose.yml.
# Order placement uses transactions, which need a replica set — a standalone
# mongod will run but will log a warning and fall back to unwrapped writes.
MONGODB_URI=mongodb://127.0.0.1:27017/skincarevault?replicaSet=rs0&directConnection=true

# ---- auth ----------------------------------------------------------------
# Generate each one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma separated. Must include the storefront origin or the browser will
# block every API call.
CORS_ORIGINS=http://localhost:3000

# ---- images --------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skincarevault

# ---- payments ------------------------------------------------------------
SSL_STORE_ID=
SSL_STORE_PASSWORD=
SSL_IS_LIVE=false

# Where the customer's browser is redirected back to.
APP_URL=http://localhost:3000

# Where the gateway posts its callbacks. Must be publicly reachable, so in
# development run `ngrok http 5050` and paste the https URL here.
API_URL=http://localhost:5050

# Minutes an unpaid gateway order may hold its stock before the sweep
# releases it back to the catalogue.
PAYMENT_RESERVATION_MINUTES=30

# ---- seed ----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@skincarevault.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
